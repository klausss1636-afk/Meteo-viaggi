<!doctype html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#071522">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

<title>Meteo Viaggio</title>

<style>
:root{
  --bg:#071522;
  --card:#102438;
  --text:#fff;
  --muted:#abc0d2;
  --green:#61dfa3;
  --blue:#4bbcff;
  --yellow:#ffd166;
  --red:#ff6262;
}

*{box-sizing:border-box}

html,body{
  margin:0;
  min-height:100%;
  background:linear-gradient(#071522,#0a1b2b 55%,#071522);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
}

.app{
  width:100%;
  max-width:760px;
  margin:auto;
  padding:18px;
}

h1{
  margin:4px 0;
  font-size:27px;
}

.sub{
  color:var(--muted);
  margin-bottom:18px;
}

.card{
  background:#102438;
  border:1px solid #ffffff18;
  border-radius:18px;
  padding:16px;
  margin:12px 0;
}

.status{
  display:flex;
  align-items:center;
  gap:8px;
  font-weight:800;
}

.dot{
  width:10px;
  height:10px;
  border-radius:50%;
  background:var(--green);
}

.alert{
  display:none;
  border-radius:18px;
  padding:18px;
  margin:14px 0;
  font-weight:800;
  font-size:18px;
  animation:pulse 1.4s infinite;
}

.alert.show{display:block}

.alert.rain{
  background:#174c73;
  border:2px solid #4bbcff;
}

.alert.storm{
  background:#604800;
  border:2px solid #ffd166;
}

.alert.hail{
  background:#663b72;
  border:2px solid #efb8ff;
}

.alert.wind{
  background:#13554c;
  border:2px solid #61dfa3;
}

.alert.fog{
  background:#3c4650;
  border:2px solid #c7d1d9;
}

.alert.danger{
  background:#711d25;
  border:2px solid #ff6262;
}

.alert-title{
  font-size:22px;
  margin-bottom:6px;
}

.alert-time{
  margin-top:8px;
  font-size:15px;
  font-weight:600;
  opacity:.9;
}

button{
  width:100%;
  border:0;
  border-radius:14px;
  padding:15px;
  margin-top:10px;
  font-size:16px;
  font-weight:900;
  color:white;
  background:linear-gradient(135deg,#3ab8ff,#687bff);
}

.small{
  font-size:13px;
  color:var(--muted);
  line-height:1.4;
}

@keyframes pulse{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.015)}
}
</style>
</head>

<body>

<div class="app">

<h1>🌦️ Meteo Viaggio</h1>
<div class="sub">Allerte meteo automatiche durante il viaggio</div>

<div class="card">
  <div class="status">
    <span class="dot"></span>
    Sistema allerte attivo
  </div>
  <p class="small">
    Meteo Viaggio controlla le condizioni nella tua posizione e segnala
    pioggia, temporali, grandine, vento forte e nebbia.
  </p>
</div>

<div id="weatherAlert" class="alert">
  <div id="alertTitle" class="alert-title"></div>
  <div id="alertText"></div>
  <div id="alertTime" class="alert-time"></div>
</div>

<div class="card">
  <b>📍 Posizione</b>
  <div id="position" class="small">Ricerca posizione...</div>

  <b style="display:block;margin-top:12px">🌤 Condizioni</b>
  <div id="conditions" class="small">In attesa dei dati meteo...</div>
</div>

<button onclick="checkWeather()">Aggiorna meteo adesso</button>

<div class="card">
  <b>🔔 Avvisi automatici</b>
  <p class="small">
    Quando viene rilevato maltempo nelle vicinanze, Meteo Viaggio mostra
    automaticamente un avviso e riproduce un segnale acustico.
  </p>
</div>

</div>

<script>

let lastAlert="";
let userLat=null;
let userLon=null;

function beep(){
  try{
    const ctx=new (window.AudioContext||window.webkitAudioContext)();
    const osc=ctx.createOscillator();
    const gain=ctx.createGain();

    osc.connect(gain);
    gain.connect(ctx.destination);

    osc.frequency.value=880;
    gain.gain.value=.18;

    osc.start();

    setTimeout(()=>{
      osc.stop();
      ctx.close();
    },350);
  }catch(e){}
}

function showAlert(type,title,text){

  const box=document.getElementById("weatherAlert");

  box.className="alert show "+type;

  document.getElementById("alertTitle").textContent=title;
  document.getElementById("alertText").textContent=text;

  const now=new Date();

  document.getElementById("alertTime").textContent=
    "Aggiornato alle "+now.toLocaleTimeString("it-IT",{
      hour:"2-digit",
      minute:"2-digit"
    });

  const key=title+"-"+text;

  if(key!==lastAlert){
    beep();
    lastAlert=key;

    if("vibrate" in navigator){
      navigator.vibrate([250,150,250]);
    }
  }
}

function clearAlert(){
  document.getElementById("weatherAlert").className="alert";
}

async function checkWeather(){

  if(userLat===null || userLon===null){
    getPosition();
    return;
  }

  document.getElementById("conditions").textContent=
    "Controllo meteo in corso...";

  try{

    const url=
      "https://api.open-meteo.com/v1/forecast"+
      "?latitude="+userLat+
      "&longitude="+userLon+
      "&current=temperature_2m,precipitation,rain,weather_code,wind_speed_10m,wind_gusts_10m"+
      "&hourly=precipitation_probability,weather_code,visibility,wind_gusts_10m"+
      "&forecast_days=1"+
      "&timezone=auto";

    const r=await fetch(url);
    const data=await r.json();

    const c=data.current;

    const temp=Math.round(c.temperature_2m);
    const rain=Number(c.rain||0);
    const precipitation=Number(c.precipitation||0);
    const wind=Number(c.wind_speed_10m||0);
    const gust=Number(c.wind_gusts_10m||0);
    const code=Number(c.weather_code||0);

    document.getElementById("conditions").textContent=
      temp+" °C • vento "+Math.round(wind)+
      " km/h • raffiche "+Math.round(gust)+" km/h";

    /*
      Codici Open-Meteo:
      45/48 nebbia
      51-67 pioggia/pioviggine
      80-82 rovesci
      95-99 temporali
      96/99 temporali con grandine
    */

    if(code===96 || code===99){
      showAlert(
        "hail",
        "🧊 ATTENZIONE GRANDINE",
        "Possibile grandine nella tua zona. Guida con prudenza."
      );
      return;
    }

    if(code>=95 && code<=99){
      showAlert(
        "storm",
        "⛈️ TEMPORALE",
        "Temporale rilevato nella tua zona. Possibili forti precipitazioni."
      );
      return;
    }

    if(gust>=70){
      showAlert(
        "danger",
        "💨 RAFFICHE MOLTO FORTI",
        "Raffiche fino a "+Math.round(gust)+" km/h. Riduci la velocità."
      );
      return;
    }

    if(gust>=50 || wind>=40){
      showAlert(
        "wind",
        "💨 VENTO FORTE",
        "Vento forte rilevato. Raffiche fino a "+Math.round(gust)+" km/h."
      );
      return;
    }

    if(code===45 || code===48){
      showAlert(
        "fog",
        "🌫️ NEBBIA",
        "Visibilità ridotta nella tua zona. Procedi con prudenza."
      );
      return;
    }

    if(
      rain>0 ||
      precipitation>0 ||
      (code>=51 && code<=67) ||
      (code>=80 && code<=82)
    ){
      showAlert(
        "rain",
        "🌧️ PIOGGIA",
        "Pioggia rilevata nella tua posizione."
      );
      return;
    }

    /*
      Controllo delle prossime ore:
      avvisa se la probabilità di pioggia supera il 60%.
    */

    if(data.hourly && data.hourly.time){

      const now=Date.now();

      for(let i=0;i<data.hourly.time.length;i++){

        const t=new Date(data.hourly.time[i]).getTime();

        if(t>=now && t<=now+(3*60*60*1000)){

          const probability=
            Number(data.hourly.precipitation_probability[i]||0);

          const futureCode=
            Number(data.hourly.weather_code[i]||0);

          if(futureCode===96 || futureCode===99){

            showAlert(
              "hail",
              "🧊 RISCHIO GRANDINE IN ARRIVO",
              "Possibile grandine nelle prossime ore."
            );
            return;
          }

          if(futureCode>=95 && futureCode<=99){

            showAlert(
              "storm",
              "⛈️ TEMPORALE IN ARRIVO",
              "Possibile temporale nelle prossime ore."
            );
            return;
          }

          if(probability>=60){

            const ora=new Date(data.hourly.time[i])
              .toLocaleTimeString("it-IT",{
                hour:"2-digit",
                minute:"2-digit"
              });

            showAlert(
              "rain",
              "🌧️ PIOGGIA IN ARRIVO",
              "Probabilità "+probability+
              "%. Prevista indicativamente dalle "+ora+"."
            );
            return;
          }
        }
      }
    }

    clearAlert();

  }catch(err){

    document.getElementById("conditions").textContent=
      "Impossibile aggiornare il meteo. Riproverò automaticamente.";
  }
}

function getPosition(){

  if(!navigator.geolocation){

    document.getElementById("position").textContent=
      "Geolocalizzazione non disponibile.";

    return;
  }

  navigator.geolocation.getCurrentPosition(

    pos=>{

      userLat=pos.coords.latitude;
      userLon=pos.coords.longitude;

      document.getElementById("position").textContent=
        "Posizione GPS acquisita";

      checkWeather();
    },

    err=>{

      document.getElementById("position").textContent=
        "Consenti l'accesso alla posizione per ricevere le allerte.";
    },

    {
      enableHighAccuracy:true,
      timeout:15000,
      maximumAge:60000
    }
  );
}

/* primo controllo */
getPosition();

/* nuovo controllo ogni 5 minuti */
setInterval(checkWeather,5*60*1000);

</script>

</body>
</html>
